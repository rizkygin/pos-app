# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# backend-owned upload storage (local dev only; persistent volume in prod)
apps/backend/uploads/

# local backups & DB dumps (sensitive — never commit)
/backups/

# large downloadable binaries served statically — kept out of git history,
# but present on disk so `railway up` (see .railwayignore) bundles them into
# the deploy. Only this machine's working copy has these; redeploy from here.
apps/frontend/public/downloads/
